# ─── HIRIS Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values before running the server.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Local dev example: postgresql://postgres@localhost:5432/hiris_db
# Docker Compose:    postgres://hiris_admin:PASSWORD@postgres:5432/hiris_db
DATABASE_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — must be a cryptographically strong random string (min 32 chars).
# Generate a secure secret:
#   openssl rand -hex 32
# WARNING: Using a weak or hardcoded secret allows anyone to forge auth tokens!
JWT_SECRET=
JWT_EXPIRY=7d

# ── Registration Guard ────────────────────────────────────────────────────────
# When set, POST /api/auth/register-org will require the caller to include
# { "registration_secret": "<value>" } in the request body.
# This prevents unauthenticated creation of admin organisations in production.
# Leave blank to disable the guard (useful for local development).
# Generate a secret:  openssl rand -hex 16
REGISTRATION_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the exact origin of your deployed frontend.
# Example: https://hiris.yourcompany.com
# Leave blank to allow all localhost origins (dev mode only).
FRONTEND_URL=

# ── AI Integration (future) ───────────────────────────────────────────────────
# Required when AI scoring and assistant features are implemented.
OPENAI_API_KEY=
